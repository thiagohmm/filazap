# =========================================================
# FilaZap — Backend Java (Spring Boot) + Frontend React SPA
# =========================================================

# --- Aplicação ---
# Porta do backend (default 8080)
SERVER_PORT=8080

# --- Banco de dados (PostgreSQL) ---
# Nota: o backend Java usa URL JDBC (não a URL estilo Prisma).
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/filazap
SPRING_DATASOURCE_USERNAME=filazap
SPRING_DATASOURCE_PASSWORD=filazap

# --- Auth / segurança ---
# Obrigatório. Gere com: openssl rand -base64 32
JWT_SECRET=__CHANGE_ME_ON_DEPLOY__

# --- WhatsApp ---
# Driver: "meta" (Cloud API oficial) ou "waha" (gateway self-hosted — paira qualquer celular via QR).
#   meta  → exige number Business Verified + costs per message.
#   waha  → works with any personal or Business phone; runs a container you host.
WHATSAPP_DRIVER=meta

# --- Meta Cloud API (usado quando WHATSAPP_DRIVER=meta) ---
# URL base da API. Em produção use a oficial: https://graph.facebook.com/v19.0
# Em desenvolvimento, aponte para o mock local: http://localhost:4000/graph
WHATSAPP_API_URL=http://localhost:4000/graph

# --- WAHA (usado quando WHATSAPP_DRIVER=waha) ---
# Base URL of the WAHA container (see the `waha` service in docker-compose.yml).
WAHA_URL=http://localhost:3000
# Transcode incoming audio to ogg/opus (WhatsApp voice notes require ogg/opus).
# Set to false only if your WAHA image has no ffmpeg.
WAHA_CONVERT_VOICE=true
# API key of the WAHA instance. Sent as the `X-Api-Key` header; stored per-channel,
# encrypted at rest, in the channel's accessToken column.
WAHA_API_KEY=
# Shared secret for webhook HMAC (X-Webhook-Hmac, sha512). Must match the
# WHATSAPP_HOOK_HMAC_KEY set on the WAHA container.
WAHA_WEBHOOK_SECRET=

# Chave mestre para criptografar credenciais do WhatsApp em repouso (>= 32 bytes).
# Gere com: openssl rand -hex 32
WHATSAPP_CREDENTIAL_ENCRYPTION_KEY=__CHANGE_ME_ON_DEPLOY__

# --- Storage de mídia ---
# "local" (padrão) ou "supabase"
MEDIA_STORAGE_DRIVER=local
# Raiz do storage local (default ./storage)
MEDIA_STORAGE_ROOT=./storage

# Supabase (opcional — usado quando MEDIA_STORAGE_DRIVER=supabase)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=filazap-media

# Variáveis de build do frontend (prefixo VITE_). Configurar antes de `npm run build`.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_STORAGE_BUCKET=filazap-media

# --- Recuperação de senha ---
# URL pública do frontend (usada no link do e-mail de reset)
APP_URL=http://localhost:5173
RESEND_API_KEY=
EMAIL_FROM=FilaZap <acesso@seu-dominio.com>

# --- Onboarding ---
# Limite de domínios permitidos para cadastro (vazio = qualquer domínio).
# Ex.: exemplo.com,empresa.com
ORGANIZATION_SIGNUP_ALLOWED_DOMAINS=
