# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL via Docker Compose)
DATABASE_URL=postgresql://filazap:filazap@localhost:5432/filazap
# Used by test compose (disposable db)
TEST_DATABASE_URL=postgresql://filazap:filazap@localhost:5433/filazap_test

# Storage de mídia. Na Vercel use "supabase"; o Docker mock força "local".
MEDIA_STORAGE_DRIVER=local
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=filazap-media
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=filazap-media

# Auth / security
# Obrigatório em produção. Gere com: openssl rand -base64 32
# NUNCA use o valor placeholder abaixo em produção.
JWT_SECRET=__CHANGE_ME_ON_DEPLOY__

# Opcional em produção: limite de domínios permitidos para onboarding.
# Ex.: exemplo.com,empresa.com (vazio = permite qualquer domínio).
ORGANIZATION_SIGNUP_ALLOWED_DOMAINS=

# Recuperação de senha (envio via Resend)
APP_URL=http://localhost:3000
RESEND_API_KEY=
EMAIL_FROM=FilaZap <acesso@seu-dominio.com>

# First administrator bootstrap (seed)
# O seed é executado apenas com senhas fortes (mín. 12 caracteres).
# Gere uma senha forte, ex.: openssl rand -base64 16
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=__CHANGE_ME_STRONG_PASSWORD__
SEED_ORG_NAME=Empresa Piloto
SEED_ORG_SLUG=empresa-piloto
# Quando true, o seed cria canal mock, equipe, contatos e conversas de demonstração.
# O docker-compose.yml habilita esta opção automaticamente.
SEED_DEMO_DATA=false

# WhatsApp Cloud API
# Base URL of the WhatsApp API. Leave unset to use the official Cloud API.
# Em produção, só a URL oficial (graph.facebook.com) é aceita.
# Point to the local mock in development: http://localhost:4000/graph
WHATSAPP_API_URL=http://localhost:4000/graph

# Master key used to encrypt per-organization WhatsApp credentials at rest.
# This is a PLATFORM secret (not per-customer).
# A chave deve ter alta entropia (>= 32 bytes aleatórios).
# Gere com: openssl rand -hex 32
WHATSAPP_CREDENTIAL_ENCRYPTION_KEY=__CHANGE_ME_ON_DEPLOY__
